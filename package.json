{
  "name": "pg-ist",
  "description": "Batteries included PostgreSQL Library for Node.js",
  "type": "module",
  "exports": {
    ".": "index.ts"
  },
  "version": "0.0.11",
  "scripts": {
    "fix": "biome check --write",
    "lint": "biome check; tsc --noEmit",
    "test": "node --test",
    "citest": "biome check && node --test --test-reporter node-test-github-reporter"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nalanj/pg-ist.git"
  },
  "keywords": ["utilities", "pg", "postgresql"],
  "author": "Alan Johnson",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/nalanj/pg-ist/issues"
  },
  "homepage": "https://github.com/nalanj/pg-ist#readme",
  "dependencies": {
    "pg": "8.16.3",
    "pg-cursor": "2.15.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.5",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/pg-cursor": "2.7.2",
    "node-test-github-reporter": "1.3.1",
    "typescript": "5.9.3"
  },
  "volta": {
    "node": "24.11.1"
  },
  "engines": {
    "node": ">=24"
  }
}
