{
  "$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",

  "files": {
    "includes": ["**", "!dist/**/*", "!package.json"]
  },
  "formatter": {
    "useEditorconfig": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "noUnusedImports": "error"
      },
      "performance": {
        "useTopLevelRegex": "error"
      }
    }
  },
  "vcs": {
    "enabled": true,
    "clientKind": "git"
  }
}
